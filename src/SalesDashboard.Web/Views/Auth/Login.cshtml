@model LoginViewModel
@{
    ViewData["Title"] = "ورود";
    ViewData["PageKind"] = "login";
}
<section class="login-card" aria-labelledby="login-title">
    <div class="login-heading">
        <span class="login-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="11" rx="3" stroke="currentColor" stroke-width="1.7" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
        </span>
        <p class="eyebrow">خوش آمدید</p>
        <h1 id="login-title">ورود به سامانه</h1>
        <p class="login-description">برای ادامه، نام کاربری و رمز عبور خود را وارد کنید.</p>
    </div>
    <form asp-controller="Auth" asp-action="Login" method="post" class="login-form">
        <input asp-for="ReturnURL" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="login-alert" role="alert"></div>
        <div class="form-field">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="login-input" dir="ltr" autocomplete="username" maxlength="50" spellcheck="false" aria-describedby="username-error" />
            <span asp-validation-for="Username" id="username-error" class="field-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" class="login-input" dir="ltr" autocomplete="current-password" maxlength="50" aria-describedby="password-error" />
            <span asp-validation-for="Password" id="password-error" class="field-error"></span>
        </div>
        <button type="submit" class="login-button">ورود به سامانه</button>
    </form>
</section>
