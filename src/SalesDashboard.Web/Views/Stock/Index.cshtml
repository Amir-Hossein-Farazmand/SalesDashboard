@model IReadOnlyList<SalesDashboard.Business.Models.StockItem>
@{ ViewData["Title"] = "موجودی انبار"; }
<section class="data-panel" aria-labelledby="page-title">
    <div class="panel-heading"><p class="eyebrow">اطلاعات فروش</p><h1 id="page-title">موجودی انبار</h1></div>
    @if (Model.Count == 0)
    {
        <p class="empty-state" role="status">موردی یافت نشد.</p>
    }
    else
    {
        <div class="data-table-wrap"><table class="table data-table">
            <thead><tr><th scope="col">نام محصول</th><th scope="col">واحد</th><th scope="col">موجودی</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr><td>@item.ProductName</td><td>@item.Unit</td><td class="@(item.StockQuantity < 10 ? "stock-low" : "stock-normal")">@item.StockQuantity</td></tr>
            }
            </tbody>
        </table></div>
    }
</section>
